{
  "buildCommand": "cd prompt-lab-web && npm ci && npm run build",
  "installCommand": "echo 'skip'",
  "outputDirectory": "prompt-lab-web/dist",
  "framework": null,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    },
    "api/telemetry.js": {
      "maxDuration": 10
    },
    "api/billing/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/privatepolicy", "destination": "/privacy.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mobile.promptlab.tools" }],
      "destination": "/mobile/index.html"
    },
    { "source": "/tools", "destination": "/tools.html" },
    { "source": "/templates", "destination": "/templates/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/mobile", "destination": "/mobile/index.html" },
    { "source": "/mobile/", "destination": "/mobile/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/embed", "destination": "/prompt-embed.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
