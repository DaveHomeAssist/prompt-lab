{
  "buildCommand": "cd prompt-lab-web && npm ci && npm run build",
  "installCommand": "echo 'skip'",
  "outputDirectory": "prompt-lab-web/dist",
  "framework": null,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    },
    "api/telemetry.js": {
      "maxDuration": 10
    },
    "api/billing/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/privatepolicy", "destination": "/privacy.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy.html", "permanent": true },
    { "source": "/pricing", "destination": "/#pricing", "permanent": false },
    { "source": "/pricing/", "destination": "/#pricing", "permanent": false }
  ],
  "headers": [
    {
      "source": "/((?!legacy-library-bridge\\.html).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/legacy-library-bridge.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://promptlab.tools https://www.promptlab.tools; base-uri 'self'; object-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mobile.promptlab.tools" }],
      "destination": "/mobile/index.html"
    },
    { "source": "/tools", "destination": "/tools.html" },
    { "source": "/templates", "destination": "/templates/index.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/companion", "destination": "/companion/index.html" },
    { "source": "/companion/", "destination": "/companion/index.html" },
    { "source": "/mobile", "destination": "/mobile/index.html" },
    { "source": "/mobile/", "destination": "/mobile/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/embed", "destination": "/prompt-embed.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
