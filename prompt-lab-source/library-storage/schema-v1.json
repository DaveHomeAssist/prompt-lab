{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptlab:library-package:1",
  "$ref": "#/$defs/Package",
  "$defs": {
    "Object": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "enum": [
            "source",
            "workspace",
            "commit",
            "source-capture",
            "library-state",
            "import-plan"
          ]
        },
        "data": {}
      },
      "required": [
        "schemaVersion",
        "kind",
        "data"
      ],
      "additionalProperties": true
    },
    "Package": {
      "type": "object",
      "properties": {
        "format": {
          "const": "promptlab-library-package"
        },
        "schemaVersion": {
          "const": 1
        },
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "head": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Object"
          }
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "libraryId",
        "head",
        "objects"
      ],
      "additionalProperties": true
    },
    "Commit": {
      "type": "object",
      "properties": {
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "enum": [
            "snapshot",
            "import"
          ]
        },
        "importPlan": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "inputState": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "libraryId",
        "operationId",
        "parents",
        "source",
        "state",
        "createdAt"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "const": "import"
              }
            }
          },
          "then": {
            "required": [
              "importPlan",
              "inputState"
            ]
          }
        }
      ]
    },
    "Preview": {
      "type": "object",
      "properties": {
        "previewId": {
          "type": "string"
        },
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Content address of the immutable source object, including its schema/kind envelope; not the raw file digest."
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "expiresAt": {
          "type": "number"
        },
        "mode": {
          "enum": [
            "snapshot",
            "import"
          ]
        },
        "commitAvailable": {
          "type": "boolean"
        },
        "importPlan": {
          "$ref": "#/$defs/LibraryImportPlan"
        }
      },
      "required": [
        "previewId",
        "libraryId",
        "expectedRevision",
        "sourceHash",
        "fingerprint",
        "expiresAt",
        "mode",
        "commitAvailable"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "import"
              }
            }
          },
          "then": {
            "required": [
              "importPlan"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "importPlan": {
                      "properties": {
                        "unresolved": {
                          "const": 0
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "commitAvailable": {
                      "const": true
                    }
                  }
                },
                "else": {
                  "properties": {
                    "commitAvailable": {
                      "const": false
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "importPlan"
              ]
            },
            "properties": {
              "commitAvailable": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parentRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "checkpointId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state": {
          "const": "committed"
        },
        "verified": {
          "const": true
        },
        "operation": {
          "enum": [
            "snapshot",
            "import"
          ]
        },
        "stateHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Content address of the committed workspace or complete library state manifest."
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Content address of the immutable source object, including its schema/kind envelope; not the raw file digest."
        },
        "counts": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "integer",
              "minimum": 1
            },
            "sources": {
              "type": "integer",
              "minimum": 1
            },
            "records": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "historyRecords": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "objects",
            "sources",
            "records",
            "historyRecords"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operationId",
        "libraryId",
        "parentRevision",
        "revision",
        "checkpointId",
        "fingerprint",
        "state",
        "verified"
      ],
      "additionalProperties": true
    },
    "Checkpoint": {
      "type": "object",
      "properties": {
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string"
        },
        "objectHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "provenance": {}
      },
      "required": [
        "libraryId",
        "revision",
        "reason",
        "objectHashes",
        "provenance"
      ],
      "additionalProperties": true
    },
    "Outbox": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "pending",
            "failed",
            "committed"
          ]
        },
        "sourceManifest": {}
      },
      "required": [
        "schemaVersion",
        "libraryId",
        "baseRevision",
        "operationId",
        "sourceHash",
        "state",
        "sourceManifest"
      ],
      "additionalProperties": true
    },
    "SourceInventory": {
      "type": "object",
      "properties": {
        "format": {
          "const": "promptlab-source-inventory"
        },
        "schemaVersion": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "surface": {
          "enum": [
            "desktop",
            "web",
            "extension"
          ]
        },
        "sourceIdentity": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          }
        },
        "sourceReadComplete": {
          "type": "boolean"
        },
        "activationReady": {
          "const": false
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "surface",
        "sourceIdentity",
        "capturedAt",
        "sources",
        "sourceReadComplete",
        "activationReady"
      ],
      "additionalProperties": true
    },
    "SourceEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "present",
            "absent",
            "unavailable",
            "changed",
            "unreviewed"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "required": [
              "code"
            ],
            "not": {
              "required": [
                "hash"
              ]
            }
          },
          "else": {
            "required": [
              "hash"
            ]
          }
        }
      ]
    },
    "ImportPlan": {
      "type": "object",
      "properties": {
        "format": {
          "const": "promptlab-import-plan"
        },
        "schemaVersion": {
          "const": 1
        },
        "sources": {
          "type": "object",
          "properties": {
            "existing": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "incoming": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "existing",
            "incoming"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "existing",
                  "incoming"
                ]
              },
              "path": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "kind": {
                "type": "string"
              },
              "sourceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "key",
              "source",
              "path",
              "kind",
              "sourceId",
              "hash"
            ],
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "selected": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "selected",
              "members"
            ],
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "new",
                  "duplicate",
                  "conflict"
                ]
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "choice": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "enum": [
                          "keep",
                          "replace",
                          "skip"
                        ]
                      },
                      "target": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "action"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dependsOn": {
                "type": "string"
              }
            },
            "required": [
              "member",
              "kind",
              "matches",
              "choice"
            ],
            "additionalProperties": false
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "path": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "sourceId": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "groupId": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "enum": [
                  "ambiguous-current-version",
                  "missing-source-reference",
                  "prompt-not-selected",
                  "ambiguous-source-reference"
                ]
              }
            },
            "required": [
              "from",
              "path",
              "sourceId",
              "kind",
              "target",
              "groupId"
            ],
            "additionalProperties": false
          }
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "activationReady": {
          "const": false
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "keep",
                  "replace",
                  "skip"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "sources",
        "nodes",
        "groups",
        "rows",
        "references",
        "unresolved",
        "activationReady",
        "fingerprint",
        "resolutions"
      ],
      "additionalProperties": false
    },
    "PreviewRequest": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "snapshot",
            "import"
          ],
          "default": "snapshot"
        },
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceText": {
          "type": "string"
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "keep",
                  "replace",
                  "skip"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "libraryId",
        "expectedRevision",
        "sourceText"
      ],
      "additionalProperties": false
    },
    "LibrarySource": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "workspace": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "source",
        "workspace"
      ],
      "additionalProperties": false
    },
    "LibraryNode": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "kind": {
          "type": "string"
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "key",
        "source",
        "path",
        "kind",
        "sourceId",
        "hash"
      ],
      "additionalProperties": false
    },
    "LibraryState": {
      "type": "object",
      "properties": {
        "format": {
          "const": "promptlab-library-state"
        },
        "schemaVersion": {
          "const": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibrarySource"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibraryNode"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "selected": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "selected",
              "members"
            ],
            "additionalProperties": false
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "path": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "sourceId": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "groupId": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "enum": [
                  "ambiguous-current-version",
                  "missing-source-reference",
                  "prompt-not-selected",
                  "ambiguous-source-reference"
                ]
              }
            },
            "required": [
              "from",
              "path",
              "sourceId",
              "kind",
              "target",
              "groupId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "sources",
        "nodes",
        "groups",
        "references"
      ],
      "additionalProperties": false
    },
    "LibraryImportPlan": {
      "type": "object",
      "properties": {
        "format": {
          "const": "promptlab-library-import-plan"
        },
        "schemaVersion": {
          "const": 1
        },
        "baseRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "incoming": {
          "$ref": "#/$defs/LibrarySource"
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "keep",
                  "replace",
                  "skip"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": true
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "description": "Workspace object address to canonical workspace-data digest; exact source byte objects are listed in manifest.sources."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "new",
                  "duplicate",
                  "conflict"
                ]
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "choice": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "enum": [
                          "keep",
