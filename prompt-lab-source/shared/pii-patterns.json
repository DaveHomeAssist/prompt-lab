{
  "version": 1,
  "constants": {
    "secretMinLength": 10,
    "envValueMinLength": 4,
    "bearerMinLength": 16,
    "urlSecretMinLength": 6,
    "pemHeaderMax": 40,
    "pemMaxSpan": 16000,
    "jwtPrefixWindow": 64,
    "emailLocalMax": 64,
    "emailDomainMax": 253,
    "tldMin": 2,
    "tldMax": 24,
    "snippetMax": 80,
    "snippetHead": 77,
    "trailingProsePunctuation": "[.,:)]+$",
    "secretReference": "^(?:\\{\\{[^{}]*\\}\\}|\\$\\{[^{}]*\\}|\\$[A-Za-z_][A-Za-z0-9_]*|%[A-Za-z_][A-Za-z0-9_]*%)$",
    "envSecretSegment": "^(?:PASSWORD|PASSWD|CREDENTIAL|PRIVATE|SECRET|TOKEN|AUTH|DSN|PWD|KEY)S?$",
    "pemHeader": "^[A-Z0-9 ]*PRIVATE KEY$",
    "pemEnd": "^-----END [A-Z0-9 ]{0,40}PRIVATE KEY-----",
    "pemBegin": "-----BEGIN ",
    "pemEndMarker": "-----END ",
    "jwtAssignmentPrefix": "(?:bearer[ \\t]|(?:token|secret|password|passwd)\\s*[:=]\\s*[\"']?)$",
    "emailLocalChar": "[A-Za-z0-9._%+-]",
    "emailDomainChar": "[A-Za-z0-9.-]",
    "emailTld": "^[A-Za-z]+$",
    "asciiWord": "[A-Za-z0-9_]",
    "schemeChar": "[A-Za-z0-9+.-]",
    "schemeStartChar": "[A-Za-z]",
    "passphraseWord": "^[A-Za-z0-9][A-Za-z0-9'-]*$",
    "envAssignment": "^(?:export[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \\t]*=[ \\t]*([\\s\\S]*)$",
    "userinfoBoundaries": "/@: \t\n\r",
    "proseWords": [
      "a",
      "an",
      "the",
      "and",
      "or",
      "but",
      "if",
      "then",
      "else",
      "it",
      "is",
      "are",
      "was",
      "were",
      "be",
      "to",
      "of",
      "for",
      "in",
      "on",
      "at",
      "by",
      "with",
      "from",
      "as",
      "that",
      "this",
      "these",
      "those",
      "my",
      "your",
      "our",
      "their",
      "we",
      "you",
      "they",
      "do",
      "does",
      "not",
      "no",
      "please",
      "more",
      "must",
      "have",
      "has",
      "had",
      "will",
      "can",
      "should",
      "would",
      "could",
      "just",
      "than",
      "into",
      "over",
      "also",
      "only",
      "about",
      "them",
      "its",
      "so"
    ]
  },
  "detectors": [
    {
      "id": "ssn",
      "label": "SSN",
      "description": "Looks like a US Social Security number.",
      "placeholder": "SSN",
      "regex": "\\b\\d{3}-?\\d{2}-?\\d{4}\\b",
      "flags": "g",
      "find": null,
      "extract": null,
      "validate": null
    },
    {
      "id": "credit_card",
      "label": "Credit card",
      "description": "Looks like a payment card number.",
      "placeholder": "CARD",
      "regex": "\\b(?:\\d[ -]*?){13,19}\\b",
      "flags": "g",
      "find": null,
      "extract": null,
      "validate": "luhn"
    },
    {
      "id": "email",
      "label": "Email address",
      "description": "Contains an email address.",
      "placeholder": "EMAIL",
      "regex": null,
      "flags": "",
      "find": "emails",
      "extract": null,
      "validate": null
    },
    {
      "id": "phone",
      "label": "Phone number",
      "description": "Looks like a phone number.",
      "placeholder": "PHONE",
      "regex": "(?:\\b(?=\\d)|(?=[+(]))(?:\\+?1[-.\\s]?)?(?:\\(?\\d{3}\\)?[-.\\s]?)\\d{3}[-.\\s]?\\d{4}\\b",
      "flags": "g",
      "find": null,
      "extract": null,
      "validate": null
    },
    {
      "id": "ip",
      "label": "IP address",
      "description": "Contains an IPv4 address.",
      "placeholder": "IP",
      "regex": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b",
      "flags": "g",
      "find": null,
      "extract": null,
      "validate": null
    },
    {
      "id": "api_key",
      "label": "API key / token",
      "description": "Looks like an API credential or token.",
      "placeholder": "API_KEY",
      "regex": "(?<![A-Za-z0-9_])(?:sk-ant-[A-Za-z0-9_-]{16,}|sk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{16,}|sk-[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{10,}|whsec_[A-Za-z0-9]{10,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{20,}|(?:api|secret|access|private)[_\\-\\s]?(?:key|token)\\s*[:=]\\s*[\"']?[A-Za-z0-9_-]{12,})(?![A-Za-z0-9])",
      "flags": "gi",
      "find": "credentialBlocks",
      "extract": null,
      "validate": null
    },
    {
      "id": "bearer_token",
      "label": "Bearer token",
      "description": "Looks like an HTTP Authorization bearer token.",
      "placeholder": "BEARER_TOKEN",
      "regex": "\\bbearer[ \\t]+([A-Za-z0-9+/_\\-]+(?:\\.[A-Za-z0-9+/_\\-]+)*=*)",
      "flags": "gi",
      "find": null,
      "extract": "group1",
      "validate": "bearerLength"
    },
    {
      "id": "secret_value",
      "label": "Secret-looking value",
      "description": "Looks like a password or secret assignment.",
      "placeholder": "SECRET",
      "regex": "\\b(?:token|secret|password|passwd|private[_-]?key|client[_-]?secret)\\b\\s*[:=]\\s*(?:\"([^\"\\r\\n]*)\"|'([^'\\r\\n]*)'|([^\\s\"'\\r\\n]+(?:[ \\t]+(?!(?:token|secret|password|passwd|private[_-]?key|client[_-]?secret)\\b\\s*[:=])[^\\s\"'\\r\\n]+)+)|([^\\s\"'\\`;&<>]+))",
      "flags": "gi",
      "find": "envAndUserinfo",
      "extract": "secret",
      "validate": "secretValue"
    }
  ]
}
